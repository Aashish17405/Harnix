# Sandbox image used when HARNIX_EXECUTION_MODE=docker.
# Contains the toolchains the agent's validation commands need. It has NO credentials and, by default,
# runs with --network none, so dependencies must be baked in here (add what your repositories need).
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir pytest ruff mypy pyright \
    && useradd --create-home --uid 1000 harnix

USER 1000:1000
WORKDIR /workspace
