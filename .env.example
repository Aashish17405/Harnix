# Harnix Configuration Example
# Environment variables support HARNIX_* (and legacy FORGE_*)

HARNIX_PROVIDER=openai
HARNIX_MODEL=gpt-5.4-nano
OPENAI_API_KEY=your-openai-api-key-here
# For Anthropic:
# HARNIX_PROVIDER=anthropic
# HARNIX_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

HARNIX_REASONING_EFFORT=none
HARNIX_MODEL_TIMEOUT_SECONDS=120
HARNIX_MODEL_MAX_TOKENS=16000
HARNIX_PRICE_INPUT_PER_MTOK=0.10
HARNIX_PRICE_OUTPUT_PER_MTOK=0.50

# Database (SQLite default; PostgreSQL + pgvector supported)
HARNIX_DATABASE_URL=sqlite:///./harnix.db
# HARNIX_DATABASE_URL=postgresql+psycopg://harnix:harnix@127.0.0.1:5432/harnix

# Execution sandbox
HARNIX_EXECUTION_MODE=docker
HARNIX_DOCKER_IMAGE=harnix-sandbox:latest
HARNIX_DOCKER_NETWORK=none
HARNIX_DOCKER_MEMORY=1g
HARNIX_DOCKER_CPUS=2
HARNIX_WORKSPACE_ROOT=./.harnix/workspaces
HARNIX_ALLOWED_REPO_ROOTS=/path/to/your/repositories
HARNIX_MAX_REPO_COPY_MB=500
HARNIX_MAX_CONCURRENT_TASKS=1

# Limits & Safeguards
HARNIX_MAX_ITERATIONS=30
HARNIX_MAX_DURATION_SECONDS=1800
HARNIX_MAX_TOOL_CALLS=200
HARNIX_MAX_RECOVERY_ATTEMPTS=2
HARNIX_TOOL_TIMEOUT_SECONDS=120
HARNIX_MAX_OUTPUT_BYTES=20000
HARNIX_MAX_READ_BYTES=100000
HARNIX_MAX_WRITE_BYTES=200000

# Neo4j Knowledge Graph (Optional)
HARNIX_GRAPH_ENABLED=false
NEO4J_PASSWORD=your-neo4j-password-here
HARNIX_NEO4J_URI=bolt://127.0.0.1:7687
HARNIX_NEO4J_USER=neo4j
HARNIX_NEO4J_DATABASE=neo4j
HARNIX_GRAPH_INDEX_TIMEOUT_SECONDS=60
HARNIX_GRAPH_BACKGROUND_INDEX_TIMEOUT_SECONDS=3600
HARNIX_GRAPH_MAX_FILES=100000
HARNIX_GRAPH_MAX_PARSE_BYTES=1000000
HARNIX_GRAPH_CONTEXT_MAX_CHARS=6000
HARNIX_GRAPH_QUERY_TIMEOUT_SECONDS=10
HARNIX_GRAPH_QUERY_MAX_RESULTS=25

# Agent Thinking & Context Management
HARNIX_THINKING_LEVEL=medium
HARNIX_OPENAI_API=chat
HARNIX_CONTEXT_WINDOW_TOKENS=200000
HARNIX_COMPACTION_ENABLED=true
HARNIX_COMPACTION_KEEP_TOKENS=15000
HARNIX_PRUNE_PROTECT_TOKENS=40000
HARNIX_PRUNE_MINIMUM_TOKENS=20000

# Skills & Sub-agents
HARNIX_SKILLS_DIRS=
HARNIX_REPO_SKILLS=false
HARNIX_AGENTS_DIR=
HARNIX_SUBAGENT_MAX_ITERATIONS=15
HARNIX_SUBAGENT_MAX_BACKGROUND=3
HARNIX_IMAGES_ENABLED=true
HARNIX_MAX_IMAGES=5
HARNIX_MAX_IMAGE_BYTES=5242880
HARNIX_SUBAGENT_MAX_TOTAL=20

# Knowledge Base & MCP Integration
HARNIX_KNOWLEDGE_ENABLED=true
HARNIX_EMBEDDING_PROVIDER=auto
HARNIX_EMBEDDING_MODEL=text-embedding-3-small
HARNIX_KNOWLEDGE_VECTOR=python
HARNIX_KNOWLEDGE_ROOTS=
HARNIX_KNOWLEDGE_INDEX_REPO=true
HARNIX_KNOWLEDGE_INDEX_MAX_FILES=500
HARNIX_KNOWLEDGE_KEYWORD_WEIGHT=0.5
HARNIX_MEMORY_ENABLED=true
HARNIX_MEMORY_WRITE=approve
HARNIX_MEMORY_CONTEXT_CHARS=4000
HARNIX_MEMORY_MAX_ENTRIES=200
HARNIX_MCP_ENABLED=true
HARNIX_MCP_CONFIG=
HARNIX_MCP_TRUST_PROJECT=false
HARNIX_MCP_START_TIMEOUT_SECONDS=30
HARNIX_TERMINAL=off
HARNIX_TERMINAL_MAX_PROCESSES=5

# Policy & Approvals
HARNIX_APPROVAL_POLICY=sensitive
HARNIX_APPROVAL_TIMEOUT_SECONDS=900
HARNIX_LOG_LEVEL=INFO
HARNIX_API_TOKEN=
HARNIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
