#!/bin/sh
# Harnix commit-msg hook: validates commit message formatting.
msg_file="$1"
subject=$(grep -v '^[[:space:]]*#' "$msg_file" | head -n 1)

if [ -z "$subject" ]; then
  echo "[commit-msg] ERROR: Commit message cannot be empty." >&2
  exit 1
fi

# Allow merge, revert, or release commits
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|Initial\ *) exit 0 ;;
esac

# Validate Conventional Commits format
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._/-]+\))?!?: .+'
if ! echo "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOF

[commit-msg] ERROR: Invalid commit message format!
  Message: "$subject"

Expected format: <type>(<optional scope>): <subject>
Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

Examples:
  feat: add independent verification engine
  fix(api): handle timeout in event stream
  docs: update quickstart guide

EOF
  exit 1
fi

if [ ${#subject} -gt 100 ]; then
  echo "[commit-msg] ERROR: Commit subject line must not exceed 100 characters (current: ${#subject})." >&2
  exit 1
fi

exit 0
